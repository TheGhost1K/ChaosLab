# Auto-detect text files and normalize line endings
* text=auto

# Specific extensions
*.cs       text diff=csharp
*.xaml     text diff=xml
*.csproj   text
*.sln      text eol=crlf
*.md       text diff=markdown
*.json     text
*.yml      text
*.yaml     text

# Binary
*.png      binary
*.jpg      binary
*.gif      binary
*.ico      binary
*.dll      binary
*.exe      binary