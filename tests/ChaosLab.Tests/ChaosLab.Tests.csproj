<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>

    <OutputType>Exe</OutputType>
    <!-- Отключаем xUnit1051: тесты специально управляют отменой сами -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>

    <!-- Метаданные сборки -->
    <DebugType>portable</DebugType>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <!-- xUnit v3 с встроенной поддержкой MTP -->
    <PackageReference Include="xunit.v3" Version="4.0.2" />

    <!-- MTP-расширения для флагов report-trx и coverage -->
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.1" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />

    <!-- Тестовые зависимости -->
    <PackageReference Include="FluentAssertions" Version="8.11.0" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ChaosLab\ChaosLab.csproj" />
  </ItemGroup>

</Project>