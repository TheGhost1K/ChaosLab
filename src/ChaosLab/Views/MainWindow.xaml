<Window x:Class="ChaosLab.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ChaosLab.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="ChaosLab 1.0 — исследование хаоса"
        Height="1000" Width="1800"
        MinHeight="700" MinWidth="1300"
        Background="{StaticResource BgMainBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="12"
        WindowStartupLocation="CenterScreen">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="350" MinWidth="300"/>
      <ColumnDefinition Width="*"   MinWidth="400"/>
      <ColumnDefinition Width="400" MinWidth="340"/>
    </Grid.ColumnDefinitions>

    <!-- ===================== ЛЕВАЯ ПАНЕЛЬ ===================== -->
    <Border Grid.Column="0"
                Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderBrushDark}"
                BorderThickness="0,0,1,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,16,18,24">
        <StackPanel>

          <TextBlock Text="CHAOSLAB"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"
                               FontFamily="{StaticResource UiFontSemibold}"/>
          <TextBlock Text="Attractors · Spectra · Fields"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,2,0,0"/>

          <!-- ==================== СИСТЕМА ==================== -->
          <TextBlock Text="СИСТЕМА" Style="{StaticResource SectionHeader}"/>
          <ComboBox Style="{StaticResource AppComboBox}"
                              ItemsSource="{Binding System.AllSystems}"
                              SelectedItem="{Binding System.Current, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Name}" Width="200"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                  <TextBlock Text="{Binding Category}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="10"
                                               VerticalAlignment="Center"/>
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <!-- ==================== РЕЖИМ ==================== -->
          <TextBlock Text="РЕЖИМ" Style="{StaticResource SectionHeader}"/>
          <ComboBox Style="{StaticResource AppComboBox}"
                          ItemsSource="{Binding Render.AllModes}"
                          SelectedIndex="{Binding Render.ModeIndex, Mode=TwoWay}"/>

          <StackPanel Visibility="{Binding Render.IsLyapunovMap,
                         Converter={x:Static vm:BoolToVisibility.Instance}}">
            <TextBlock Text="ОСЬ X (параметр)" Style="{StaticResource SectionHeader}"/>
            <ComboBox Style="{StaticResource AppComboBox}"
              ItemsSource="{Binding Render.AllParamNames}"
              SelectedIndex="{Binding Render.LyapXIndex, Mode=TwoWay}"/>

            <TextBlock Text="ОСЬ Y (параметр)" Style="{StaticResource SectionHeader}"/>
            <ComboBox Style="{StaticResource AppComboBox}"
              ItemsSource="{Binding Render.AllParamNames}"
              SelectedIndex="{Binding Render.LyapYIndex, Mode=TwoWay}"/>
          </StackPanel>

          <!-- Параметр бифуркации — виден только в режиме Bifurcation -->
          <StackPanel Visibility="{Binding Render.IsBifurcation,
                                             Converter={x:Static vm:BoolToVisibility.Instance}}">
            <TextBlock Text="ПАРАМЕТР БИФУРКАЦИИ"
                                   Style="{StaticResource SectionHeader}"/>
            <ComboBox Style="{StaticResource AppComboBox}"
                                  ItemsSource="{Binding Render.BifParamNames}"
                                  SelectedIndex="{Binding Render.BifParamIndex, Mode=TwoWay}"/>
          </StackPanel>

          <!-- ==================== ПАРАМЕТРЫ ==================== -->
          <TextBlock Text="ПАРАМЕТРЫ" Style="{StaticResource SectionHeader}"/>
          <ItemsControl ItemsSource="{Binding System.Params}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,6,0,4">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Def.Name}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       ToolTip="{Binding Def.Description}"/>
                      <TextBlock Text=" ⇆ развёрнут"
                                                       Foreground="{StaticResource WarnBrush}"
                                                       FontSize="10"
                                                       Margin="6,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding IsSwept,
                                                             Converter={x:Static vm:BoolToVisibility.Instance}}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                                                   Text="{Binding Value, StringFormat=G4}"
                                                   Style="{StaticResource ValueText}"/>
                  </Grid>
                  <Slider Style="{StaticResource AppSlider}"
                                            Minimum="{Binding Def.Min}"
                                            Maximum="{Binding Def.Max}"
                                            Value="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            SmallChange="{Binding Def.Step}"
                                            ToolTip="{Binding Def.Description}"
                                            IsEnabled="{Binding IsSwept,
                                                  Converter={x:Static vm:InvertBool.Instance}}"
                                            Opacity="{Binding IsSwept,
                                                  Converter={x:Static vm:InvertBoolToOpacity.Instance}}"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- ==================== РЕНДЕР ==================== -->
          <TextBlock Text="РЕНДЕР" Style="{StaticResource SectionHeader}"/>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Iterations"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1"
                                   Text="{Binding Render.StepsLabel}"
                                   Style="{StaticResource ValueText}"/>
          </Grid>
          <Slider Style="{StaticResource AppSlider}"
                            Minimum="3" Maximum="8"
                            Value="{Binding Render.Steps, Converter={x:Static vm:LogConverter.Instance}, Mode=TwoWay}"/>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="dt"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1"
                                   Text="{Binding Render.DtLabel}"
                                   Style="{StaticResource ValueText}"/>
          </Grid>
          <Slider Style="{StaticResource AppSlider}"
                            Minimum="-4" Maximum="-1"
                            Value="{Binding Render.Dt,
                                    Converter={x:Static vm:LogConverter.Instance},
                                    Mode=TwoWay}"/>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Gamma"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1"
                                   Text="{Binding Render.GammaLabel}"
                                   Style="{StaticResource ValueText}"/>
          </Grid>
          <Slider Style="{StaticResource AppSlider}"
                            Minimum="0.3" Maximum="2.5"
                            Value="{Binding Render.Gamma, Mode=TwoWay}"/>

          <CheckBox Content="Use Verlet integrator"
          Margin="0,6,0,2"
          IsChecked="{Binding Render.UseVerlet, Mode=TwoWay}"
          IsEnabled="{Binding Render.CanUseVerlet}"
          ToolTip="Симплектический интегратор. Доступен только для Hénon-Heiles и других гамильтоновых систем."/>

          <CheckBox Content="Use Adaptive RK45"
          Margin="0,4,0,2"
          IsChecked="{Binding Render.UseAdaptiveRk45, Mode=TwoWay}"
          ToolTip="Адаптивный интегратор 5-го порядка с контролем ошибки. Работает только для потоков."/>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="RK45 Tolerance"
               Foreground="{StaticResource TextSecondaryBrush}"
               VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1"
               Text="{Binding Render.Rk45ToleranceLabel}"
               Style="{StaticResource ValueText}"/>
          </Grid>
          <Slider Style="{StaticResource AppSlider}"
        Minimum="-8" Maximum="-2"
        Value="{Binding Render.Rk45ToleranceLog, Mode=TwoWay}"
        IsEnabled="{Binding Render.UseAdaptiveRk45}"/>

          <CheckBox Content="Vector field overlay"
          Margin="0,6,0,4"
          IsChecked="{Binding Render.ShowVectorField, Mode=TwoWay}"
          IsEnabled="{Binding Render.CanShowVectorField}"
          ToolTip="Слой стрелок над аттрактором (только для 2D отображений: Hénon, Clifford, De Jong, Tinkerbell)."/>

          <!-- ==================== ПАЛИТРА ==================== -->
          <TextBlock Text="ПАЛИТРА" Style="{StaticResource SectionHeader}"/>
          <ComboBox Style="{StaticResource AppComboBox}"
                              ItemsSource="{Binding Render.AllPalettes}"
                              SelectedItem="{Binding Render.PaletteName, Mode=TwoWay}"/>

          <!-- ==================== КАМЕРА ==================== -->
          <TextBlock Text="КАМЕРА" Style="{StaticResource SectionHeader}"/>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Yaw"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1"
                                   Text="{Binding Camera.YawText}"
                                   Style="{StaticResource ValueText}"/>
          </Grid>
          <Slider Style="{StaticResource AppSlider}"
                            Minimum="-3.14" Maximum="3.14"
                            Value="{Binding Camera.Yaw, Mode=TwoWay}"
                            IsEnabled="{Binding Camera.Enabled}"/>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Pitch"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1"
                                   Text="{Binding Camera.PitchText}"
                                   Style="{StaticResource ValueText}"/>
          </Grid>
          <Slider Style="{StaticResource AppSlider}"
                            Minimum="-1.57" Maximum="1.57"
                            Value="{Binding Camera.Pitch, Mode=TwoWay}"
                            IsEnabled="{Binding Camera.Enabled}"/>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Zoom"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1"
                                   Text="{Binding Camera.ZoomText}"
                                   Style="{StaticResource ValueText}"/>
          </Grid>
          <Slider Style="{StaticResource AppSlider}"
                            Minimum="1" Maximum="500"
                            Value="{Binding Camera.Zoom, Mode=TwoWay}"/>

          <!-- ==================== ДЕЙСТВИЯ ==================== -->
          <TextBlock Text="ДЕЙСТВИЯ" Style="{StaticResource SectionHeader}"/>
          <WrapPanel>
            <Button Content="▶ Render"
                                Command="{Binding RenderCommand}"
                                Style="{StaticResource PrimaryButton}"/>
            <Button Content="{Binding Render.AnimateButtonText}"
                                Command="{Binding Render.ToggleAnimateCommand}"
                                Style="{StaticResource AppButton}"/>
            <Button Content="Clear"
                                Command="{Binding ClearCommand}"
                                Style="{StaticResource AppButton}"/>
            <Button Content="⟲ Reset Cam"
                                Command="{Binding ResetCameraCommand}"
                                Style="{StaticResource AppButton}"/>
            <Button Content="💾 PNG"
                                Command="{Binding SavePngCommand}"
                                Style="{StaticResource AppButton}"/>
          </WrapPanel>

        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- ===================== ЦЕНТРАЛЬНЫЙ ХОЛСТ ===================== -->
    <Grid Grid.Column="1"
              x:Name="CanvasHost"
              Background="#FF03050A"
              ClipToBounds="True"
              SizeChanged="CanvasHost_SizeChanged"
              MouseWheel="CanvasHost_MouseWheel"
              MouseLeftButtonDown="CanvasHost_MouseDown"
              MouseLeftButtonUp="CanvasHost_MouseUp"
              MouseMove="CanvasHost_MouseMove"
              MouseRightButtonDown="CanvasHost_MouseRightButtonDown">

      <Image Source="{Binding Render.Bitmap}"
                   Stretch="Fill"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

      <!-- HUD -->
      <Border VerticalAlignment="Top" HorizontalAlignment="Right"
                    Margin="14" Padding="12,8"
                    CornerRadius="8"
                    Background="#CC0F1620"
                    BorderBrush="{StaticResource BorderBrushDark}"
                    BorderThickness="1">
        <StackPanel>
          <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="11"
                               Foreground="{StaticResource WarnBrush}">
                        <Run Text="Mode    "/>
                        <Run Text="{Binding Render.ModeLabel, Mode=OneWay}"/>
          </TextBlock>
          <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="11"
                               Foreground="{StaticResource AccentBrightBrush}">
                        <Run Text="Points  "/>
                        <Run Text="{Binding Render.TotalPoints, Mode=OneWay, StringFormat=N0}"/>
          </TextBlock>
          <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}">
                        <Run Text="Render  "/>
                        <Run Text="{Binding Render.LastFrameMs, Mode=OneWay}"/>
                        <Run Text=" ms"/>
          </TextBlock>
          <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}">
                        <Run Text="Size    "/>
                        <Run Text="{Binding Render.BmpW, Mode=OneWay}"/>
                        <Run Text="×"/>
                        <Run Text="{Binding Render.BmpH, Mode=OneWay}"/>
          </TextBlock>
          <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="11"
                               Foreground="{StaticResource DangerBrush}"
                               Text="{Binding Render.LastError}"
                               TextWrapping="Wrap"
                               MaxWidth="280"
                               Visibility="{Binding Render.HasError,
                                     Converter={x:Static vm:BoolToVisibility.Instance}}"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ===================== ПРАВАЯ ПАНЕЛЬ ===================== -->
    <Border Grid.Column="2"
                Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderBrushDark}"
                BorderThickness="1,0,0,0">
      <TabControl>
        <TabItem Header="Анализ">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,16,18,24">
            <StackPanel>

              <TextBlock Text="СПЕКТР ЛЯПУНОВА"
                                       Style="{StaticResource SectionHeader}"
                                       Margin="0,0,0,4"/>
              <TextBlock Text="{Binding Analysis.LyapunovSpectrumText}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="12"
                                       Foreground="{StaticResource AccentBrush}"
                                       LineHeight="18"/>
              <TextBlock Text="{Binding Analysis.LyapunovStatus}"
                                       FontSize="10"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"/>
              <TextBlock Text="{Binding Analysis.KaplanYorkeText}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="12"
                                       Foreground="{StaticResource AccentBrightBrush}"
                                       Margin="0,4,0,0"/>

              <TextBlock Text="РАЗМЕРНОСТИ" Style="{StaticResource SectionHeader}"/>
              <TextBlock Text="{Binding Analysis.CorrelationText}"
                                       FontFamily="{StaticResource MonoFont}"
                                       Foreground="{StaticResource AccentBrightBrush}"/>
              <TextBlock Text="{Binding Analysis.BoxCountingText}"
                                       FontFamily="{StaticResource MonoFont}"
                                       Foreground="#FFA78BFA"/>

              <TextBlock Text="ЭНТРОПИИ" Style="{StaticResource SectionHeader}"/>
              <TextBlock Text="{Binding Analysis.SampleEntropyText}"
                                       FontFamily="{StaticResource MonoFont}"/>
              <TextBlock Text="{Binding Analysis.PermutationEntropyText}"
                                       FontFamily="{StaticResource MonoFont}"/>

              <TextBlock Text="СТАТИСТИКА" Style="{StaticResource SectionHeader}"/>
              <TextBlock Text="{Binding Analysis.HurstText}"
                                       FontFamily="{StaticResource MonoFont}"/>
              <TextBlock Text="{Binding Analysis.DfaText}"
                                       FontFamily="{StaticResource MonoFont}"/>
              <TextBlock Text="{Binding Analysis.ZeroOneText}"
                                       FontFamily="{StaticResource MonoFont}"/>

              <TextBlock Text="RQA" Style="{StaticResource SectionHeader}"/>
              <TextBlock Text="{Binding Analysis.RqaText}"
                                       FontFamily="{StaticResource MonoFont}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"/>

              <TextBlock Text="ГЕОМЕТРИЯ" Style="{StaticResource SectionHeader}"/>
              <TextBlock Text="{Binding Analysis.PoincareText}"
                                       FontFamily="{StaticResource MonoFont}"/>
              <TextBlock Text="{Binding Analysis.BasinsText}"
                                       FontFamily="{StaticResource MonoFont}"/>

              <TextBlock Text="СИМВОЛЬНАЯ ДИНАМИКА" Style="{StaticResource SectionHeader}"/>
              <TextBlock Text="{Binding Analysis.SymbolicText}"
                                       FontFamily="{StaticResource MonoFont}"
                                       Foreground="{StaticResource AccentBrightBrush}"
                                       TextWrapping="Wrap" LineHeight="16"/>

              <TextBlock Text="РЕЗОНАНСЫ" Style="{StaticResource SectionHeader}"/>
              <TextBlock Text="{Binding Analysis.ResonanceText}"
                                       FontFamily="{StaticResource MonoFont}"
                                       Foreground="{StaticResource AccentBrightBrush}"
                                       TextWrapping="Wrap" LineHeight="16"/>

              <TextBlock Text="MULTISCALE ENTROPY" Style="{StaticResource SectionHeader}"/>
              <TextBlock Text="{Binding Analysis.MultiscaleText}"
                                       FontFamily="{StaticResource MonoFont}"
                                       Foreground="{StaticResource AccentBrightBrush}"
                                       TextWrapping="Wrap" LineHeight="16"/>

              <TextBlock Text="СЛОЖНОСТЬ" Style="{StaticResource SectionHeader}"/>
              <TextBlock Text="{Binding Analysis.ApEnText}"
                                       FontFamily="{StaticResource MonoFont}"
                                       Foreground="{StaticResource AccentBrightBrush}"
                                       TextWrapping="Wrap"/>
              <TextBlock Text="{Binding Analysis.LzText}"
                                       FontFamily="{StaticResource MonoFont}"
                                       Foreground="{StaticResource AccentBrightBrush}"/>
              <TextBlock Text="{Binding Analysis.HiguchiText}"
                                       FontFamily="{StaticResource MonoFont}"
                                       Foreground="{StaticResource AccentBrightBrush}"/>

              <TextBlock Text="ЭНТРОПИЯ KS" Style="{StaticResource SectionHeader}"/>
              <TextBlock Text="{Binding Analysis.KsEntropyText}"
                                       FontFamily="{StaticResource MonoFont}"
                                       Foreground="{StaticResource AccentBrightBrush}"
                                       TextWrapping="Wrap"/>

              <TextBlock Text="ПРЕДСКАЗУЕМОСТЬ" Style="{StaticResource SectionHeader}"/>
              <TextBlock Text="{Binding Analysis.PredictabilityText}"
                                       FontFamily="{StaticResource MonoFont}"
                                       Foreground="{StaticResource AccentBrightBrush}"
                                       TextWrapping="Wrap"/>
              <TextBlock Text="{Binding Analysis.BasinEntropyText}"
                                       FontFamily="{StaticResource MonoFont}"
                                       Foreground="{StaticResource AccentBrightBrush}"
                                       TextWrapping="Wrap"/>

              <TextBlock Text="УРАВНЕНИЯ" Style="{StaticResource SectionHeader}"/>
              <Border Background="#FF080B10" CornerRadius="6" Padding="12,10">
                <TextBlock Text="{Binding Render.EquationsText}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="12"
                                   Foreground="{StaticResource AccentBrightBrush}"
                                   LineHeight="18"
                                   TextWrapping="Wrap"/>
              </Border>

              <TextBlock Text="КОМАНДЫ" Style="{StaticResource SectionHeader}"/>
              <WrapPanel>
                <Button Content="λ Спектр"
                                        Command="{Binding Analysis.LyapunovCommand}"
                                        Style="{StaticResource AppButton}"/>
                <Button Content="D₂"
                                        Command="{Binding Analysis.CorrelationCommand}"
                                        Style="{StaticResource AppButton}"/>
                <Button Content="Entropy"
                                        Command="{Binding Analysis.EntropiesCommand}"
                                        Style="{StaticResource AppButton}"/>
                <Button Content="Hurst"
                                        Command="{Binding Analysis.HurstCommand}"
                                        Style="{StaticResource AppButton}"/>
                <Button Content="DFA"
                                        Command="{Binding Analysis.DfaCommand}"
                                        Style="{StaticResource AppButton}"/>
                <Button Content="0–1"
                                        Command="{Binding Analysis.ZeroOneCommand}"
                                        Style="{StaticResource AppButton}"/>
                <Button Content="RQA"
                                        Command="{Binding Analysis.RqaCommand}"
                                        Style="{StaticResource AppButton}"/>
                <Button Content="Пуанкаре"
                                        Command="{Binding Analysis.PoincareCommand}"
                                        Style="{StaticResource AppButton}"/>
                <Button Content="Бассейны"
                                        Command="{Binding Analysis.BasinsCommand}"
                                        Style="{StaticResource AppButton}"/>
                <Button Content="Symbolic"
                                        Command="{Binding Analysis.SymbolicCommand}"
                                        Style="{StaticResource AppButton}"/>
                <Button Content="Resonance"
                                        Command="{Binding Analysis.ResonanceCommand}"
                                        Style="{StaticResource AppButton}"/>
                <Button Content="Multiscale"
                                        Command="{Binding Analysis.MultiscaleCommand}"
                                        Style="{StaticResource AppButton}"/>
                <Button Content="ApEn"
                                        Command="{Binding Analysis.ApEnCommand}"
                                        Style="{StaticResource AppButton}"/>
                <Button Content="LZ"
                                        Command="{Binding Analysis.LzComplexityCommand}"
                                        Style="{StaticResource AppButton}"/>
                <Button Content="Higuchi FD"
                                        Command="{Binding Analysis.HiguchiFdCommand}"
                                        Style="{StaticResource AppButton}"/>
                <Button Content="h_KS"
                                        Command="{Binding Analysis.KsEntropyCommand}"
                                        Style="{StaticResource AppButton}"/>
                <Button Content="Basin Entropy"
                                        Command="{Binding Analysis.BasinEntropyCommand}"
                                        Style="{StaticResource AppButton}"/>
                <Button Content="Predictability"
                                        Command="{Binding Analysis.PredictabilityCommand}"
                                        Style="{StaticResource AppButton}"/>
              </WrapPanel>

              <Button Content="▶ Запустить всё"
                                    Command="{Binding Analysis.RunAllCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="0,10,0,4"/>
              <Button Content="✖ Отмена"
                                    Command="{Binding Analysis.CancelCommand}"
                                    Style="{StaticResource AppButton}"/>

              <TextBlock Text="{Binding Analysis.ProgressText}"
                                       Foreground="{StaticResource AccentBrightBrush}"
                                       FontSize="11"
                                       Margin="0,10,0,0"/>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Справка">
          <ScrollViewer Padding="18,16,18,24" VerticalScrollBarVisibility="Auto">
            <StackPanel>

              <TextBlock Text="О ПРОГРАММЕ" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
              <TextBlock TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12" LineHeight="18">
                <Run Text="ChaosLab — исследовательская среда для изучения детерминированного хаоса. 30 вычислительных моделей, 9 режимов отображения, 24 метода нелинейного анализа."/>
              </TextBlock>

              <TextBlock Text="СИСТЕМЫ" Style="{StaticResource SectionHeader}"/>
              <TextBlock TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12" LineHeight="18">
                <Run Text="• 20 потоков: Lorenz, Rössler, Chua, Hénon-Heiles, FPUT-β, Coupled Pendulums, Lorenz-96"/>
                <LineBreak/>
                <Run Text="• 12 отображений: Logistic, Hénon, Ikeda, Clifford, De Jong, Tinkerbell, Arnold Cat, Circle, Gumowski-Mira, Chirikov, Tent, Gauss"/>
                <LineBreak/>
                <Run Text="• Gray-Scott — реакционно-диффузионная система (2D-поле)" FontWeight="SemiBold"/>
              </TextBlock>

              <TextBlock Text="РЕЖИМЫ ОТОБРАЖЕНИЯ" Style="{StaticResource SectionHeader}"/>
              <TextBlock TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12" LineHeight="18">
                <Run Text="• " FontWeight="Bold"/><Run Text="Attractor" FontWeight="SemiBold"/>
                <Run Text=" — фазовый портрет системы"/>
                <LineBreak/>
                <Run Text="• " FontWeight="Bold"/><Run Text="Bifurcation" FontWeight="SemiBold"/>
                <Run Text=" — диаграмма удвоения периода по выбранному параметру"/>
                <LineBreak/>
                <Run Text="• " FontWeight="Bold"/><Run Text="Lyapunov Map" FontWeight="SemiBold"/>
                <Run Text=" — тепловая карта старшего показателя λ₁ по двум параметрам"/>
                <LineBreak/>
                <Run Text="• " FontWeight="Bold"/><Run Text="Cobweb" FontWeight="SemiBold"/>
                <Run Text=" — паутина итераций для 1D-отображений"/>
                <LineBreak/>
                <Run Text="• " FontWeight="Bold"/><Run Text="Power Spectrum" FontWeight="SemiBold"/>
                <Run Text=" — спектральная плотность через FFT"/>
                <LineBreak/>
                <Run Text="• " FontWeight="Bold"/><Run Text="Return Map" FontWeight="SemiBold"/>
                <Run Text=" — отображение xₙ → xₙ₊₁ по локальным максимумам"/>
                <LineBreak/>
                <Run Text="• " FontWeight="Bold"/><Run Text="FNN + MI" FontWeight="SemiBold"/>
                <Run Text=" — диагностика размерности вложения и задержки"/>
                <LineBreak/>
                <Run Text="• " FontWeight="Bold"/><Run Text="Multifractal" FontWeight="SemiBold"/>
                <Run Text=" — обобщённые размерности D_q и спектр f(α)"/>
                <LineBreak/>
                <Run Text="• " FontWeight="Bold"/><Run Text="Multiscale Entropy" FontWeight="SemiBold"/>
                <Run Text=" — энтропия как функция временного масштаба"/>
              </TextBlock>

              <TextBlock Text="МЕТОДЫ АНАЛИЗА" Style="{StaticResource SectionHeader}"/>
              <TextBlock TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12" LineHeight="18">
